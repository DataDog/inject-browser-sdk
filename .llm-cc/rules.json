{
  "exclude": [
    "third_party/**",
    "**/third_party/**",
    "vendor/**",
    "**/vendor/**",
    "vendored/**",
    "**/vendored/**",
    "node_modules/**",
    "**/node_modules/**",
    "generated/**",
    "**/generated/**",
    "upstream/**",
    "**/upstream/**",
    "*.pb.go",
    "*.pb.cc",
    "*.pb.h",
    "*.min.js",
    "**/*.pb.go",
    "**/*.pb.cc",
    "**/*.pb.h",
    "**/*.min.js",
    "**/target/**",
    "**/build/**",
    "build_out/**",
    "injector_IIS/include/**",
    ".cache/**",
    "comparison/**",
    ".llm-cc-shared/**",
    "injector_IIS/test/unittests/iis_interfaces_reference.h"
  ],
  "tests": [
    "test/**",
    "**/test/**",
    "tests/**",
    "**/tests/**",
    "testdata/**",
    "**/testdata/**",
    "fixtures/**",
    "**/fixtures/**",
    "fixture/**",
    "**/fixture/**",
    "fuzz/**",
    "**/fuzz/**",
    "fuzzers/**",
    "**/fuzzers/**",
    "bench/**",
    "**/bench/**",
    "benchmark/**",
    "**/benchmark/**",
    "benchmarks/**",
    "**/benchmarks/**",
    "testing/**",
    "**/testing/**",
    "test_helpers/**",
    "**/test_helpers/**",
    "pytest_plugins/**",
    "**/pytest_plugins/**",
    "test_*",
    "**/test_*",
    "bench_*",
    "**/bench_*",
    "fuzz_*",
    "**/fuzz_*",
    "*_test.*",
    "**/*_test.*",
    "*_tests.*",
    "**/*_tests.*",
    "*_benchmark.*",
    "**/*_benchmark.*",
    "conftest.py",
    "**/conftest.py",
    "ci/cmake-consumer-test/**",
    "cmd/test_inject/**"
  ],
  "tooling": [
    "tools/**",
    "examples/**",
    "scripts/**",
    ".github/**",
    ".gitlab/**",
    "injector_IIS/tasks/**",
    "injector_IIS/scripts/**"
  ],
  "extensions": {
    ".h": "cpp"
  },
  "paths": [
    {
      "pattern": "injector_IIS/src/*.cpp.in",
      "language": "cpp"
    }
  ]
}
