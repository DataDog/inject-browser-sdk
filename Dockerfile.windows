# Dockerfile for Windows MSVC cross-compilation and Wine-based test execution.
#
# This vendors the cross-rs MSVC/Wine setup so Cargo and CMake both use the
# real Microsoft toolchain for x86_64-pc-windows-msvc builds.

FROM ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive
ARG RUST_VERSION=1.89.0
ARG ARCH=x64

COPY docker/windows-msvc/common.sh docker/windows-msvc/lib.sh /
RUN bash /common.sh

COPY docker/windows-msvc/cmake.sh /
RUN bash /cmake.sh

# Install the MSVC toolchain in a separate layer so Docker can cache it.
COPY docker/windows-msvc/msvc-wine.sh /
RUN bash /msvc-wine.sh

COPY docker/windows-msvc/wine.sh /
RUN bash /wine.sh

COPY docker/windows-msvc/perl.sh /
RUN bash /perl.sh

COPY docker/windows-msvc/msvc-wine-symlink.sh /
RUN bash /msvc-wine-symlink.sh "$ARCH"

RUN apt-get update && \
    apt-get install --assume-yes --no-install-recommends ninja-build && \
    rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:/opt/msvc/bin/${ARCH}:${PATH}

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
      -y --profile minimal --default-toolchain ${RUST_VERSION} && \
    rustup target add x86_64-pc-windows-msvc aarch64-pc-windows-msvc

# run-detectors are responsible for calling the correct interpreter for exe
# files. For some reason it does not work inside a docker container, so we
# route them straight to wine like the upstream image does.
RUN mkdir -p /usr/lib/binfmt-support/ && \
    rm -f /usr/lib/binfmt-support/run-detectors /usr/bin/run-detectors && \
    ln -s /usr/bin/wine /usr/lib/binfmt-support/run-detectors && \
    ln -s /usr/bin/wine /usr/bin/run-detectors

COPY docker/windows-msvc/msvc-windows-entry.sh /
ENTRYPOINT ["/msvc-windows-entry.sh"]

ENV CROSS_SYSROOT=/opt/msvc/vc/tools/msvc/latest
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER=link.exe
ENV CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_RUNNER=wine
ENV CC_x86_64_pc_windows_msvc=cl.exe
ENV CXX_x86_64_pc_windows_msvc=cl.exe
ENV VSINSTALLDIR=/opt/msvc
ENV VCINSTALLDIR=/opt/msvc/vc
ENV VSCMD_ARG_TGT_ARCH=${ARCH}
ENV WINEDEBUG=-all
ENV WINEPATH=C:/windows/syswow64\;C:/windows/system32\;/opt/msvc/bin/${ARCH}
ENV CROSS_WINDOWS_PERL=1

WORKDIR /work
