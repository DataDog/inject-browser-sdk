# Marketing version comes from VERSION; BUILD is the GitLab pipeline IID.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../VERSION" _IIS_VERSION_RAW)
string(STRIP "${_IIS_VERSION_RAW}" _IIS_VERSION_RAW)
if(_IIS_VERSION_RAW MATCHES "^([0-9]+)\\.([0-9]+)(-(.+))?$")
  set(IIS_INJECTOR_VERSION_MAJ "${CMAKE_MATCH_1}")
  set(IIS_INJECTOR_VERSION_MIN "${CMAKE_MATCH_2}")
  set(IIS_INJECTOR_VERSION_PRE "${CMAKE_MATCH_4}")
else()
  message(FATAL_ERROR "Invalid IIS VERSION: '${_IIS_VERSION_RAW}' (expected MAJ.MIN or MAJ.MIN-PRE)")
endif()
set(IIS_INJECTOR_VERSION_BUILD "$ENV{CI_PIPELINE_IID}")
if(IIS_INJECTOR_VERSION_BUILD STREQUAL "")
  set(IIS_INJECTOR_VERSION_BUILD "0")
endif()

# Build helpers pass these values to both CMake and MSBuild. Read them on every
# configure instead of caching overrides that could retain an earlier IID.
foreach(field MAJ MIN BUILD)
  if(DEFINED ENV{${field}_VER})
    set(IIS_INJECTOR_VERSION_${field} "$ENV{${field}_VER}")
  endif()
endforeach()
if(DEFINED ENV{VERSION_PRE})
  set(IIS_INJECTOR_VERSION_PRE "$ENV{VERSION_PRE}")
endif()
if("$ENV{IIS_RELEASE_BUILD}" STREQUAL "1")
  set(IIS_INJECTOR_VERSION_PRE "")
endif()

# MSI uses 8-bit major/minor and a 16-bit build, ignoring any fourth field.
foreach(field MAJ MIN BUILD)
  set(value "${IIS_INJECTOR_VERSION_${field}}")
  if(NOT value MATCHES "^[0-9]+$")
    message(FATAL_ERROR "${field}_VER must contain decimal digits, got '${value}'")
  endif()
  string(REGEX REPLACE "^0+" "" value "${value}")
  if(value STREQUAL "")
    set(value "0")
  endif()
  if(field STREQUAL "BUILD")
    set(maximum 65535)
    set(max_digits 5)
  else()
    set(maximum 255)
    set(max_digits 3)
  endif()
  string(LENGTH "${value}" digits)
  if(digits GREATER max_digits OR value GREATER maximum)
    message(FATAL_ERROR "${field}_VER=${value} exceeds the Windows Installer limit (${maximum})")
  endif()
  set(IIS_INJECTOR_VERSION_${field} "${value}")
endforeach()
set(IIS_INJECTOR_VERSION "${IIS_INJECTOR_VERSION_MAJ}.${IIS_INJECTOR_VERSION_MIN}.${IIS_INJECTOR_VERSION_BUILD}")
