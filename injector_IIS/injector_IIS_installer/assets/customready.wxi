<Include>
    <Dialog Id="CustomVerifyReadyDlg" Width="370" Height="270" Title="[ProductName]" TrackDiskSpace="yes">
        <Control Id="HeaderImage" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="Heading" Type="Text" X="15" Y="12" Width="340" Height="22" Transparent="yes" NoPrefix="yes" Text="!(loc.RUMReadyHeading)" />

        <!-- Summaries describe the operation selected by the preceding dialog. -->
        <Control Id="InstallSummary" Type="Text" X="25" Y="65" Width="320" Height="48" Hidden="yes" NoPrefix="yes" Text="!(loc.RUMReadyInstall)">
            <Condition Action="show">NOT Installed</Condition>
        </Control>
        <Control Id="RepairSummary" Type="Text" X="25" Y="65" Width="320" Height="48" Hidden="yes" NoPrefix="yes" Text="!(loc.RUMReadyRepair)">
            <Condition Action="show">Installed AND NOT PATCH AND WixUI_InstallMode = "Repair"</Condition>
        </Control>
        <Control Id="RemoveSummary" Type="Text" X="25" Y="65" Width="320" Height="48" Hidden="yes" NoPrefix="yes" Text="!(loc.RUMReadyRemove)">
            <Condition Action="show">Installed AND NOT PATCH AND WixUI_InstallMode = "Remove"</Condition>
        </Control>
        <Control Id="ChangeSummary" Type="Text" X="25" Y="65" Width="320" Height="48" Hidden="yes" NoPrefix="yes" Text="!(loc.RUMReadyChange)">
            <Condition Action="show">Installed AND NOT PATCH AND WixUI_InstallMode = "Change"</Condition>
        </Control>
        <Control Id="UpdateSummary" Type="Text" X="25" Y="65" Width="320" Height="48" Hidden="yes" NoPrefix="yes" Text="!(loc.RUMReadyUpdate)">
            <Condition Action="show">Installed AND (PATCH OR WixUI_InstallMode = "Update")</Condition>
        </Control>
        <Control Id="RestartWarning" Type="Text" X="25" Y="130" Width="320" Height="40" NoPrefix="yes" Text="!(loc.CustomVerifyReadyDlgIISWarning)" />

        <Control Id="FooterSeparator" Type="Line" X="15" Y="230" Width="340" Height="0" />
        <!-- Product.wxs supplies the operation-specific destination for Back. -->
        <Control Id="Back" Type="PushButton" X="150" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
            <Condition Action="default">WixUI_InstallMode = "Remove"</Condition>
        </Control>
        <!-- All operations affect a per-machine installation. -->
        <Control Id="Apply" Type="PushButton" X="212" Y="243" Width="80" Height="17" Default="yes" ElevationShield="yes" Text="!(loc.RUMReadyApply)">
            <!-- Make the same operation selection whether or not rollback fits. -->
            <Publish Event="EnableRollback" Value="False" Order="1">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST = "D"</Publish>
            <Publish Event="ReinstallMode" Value="ecmus" Order="2"><![CDATA[Installed AND NOT PATCH AND WixUI_InstallMode = "Repair" AND (OutOfDiskSpace <> 1 OR (OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST = "D"))]]></Publish>
            <Publish Event="Reinstall" Value="All" Order="3"><![CDATA[Installed AND NOT PATCH AND WixUI_InstallMode = "Repair" AND (OutOfDiskSpace <> 1 OR (OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST = "D"))]]></Publish>
            <Publish Event="Remove" Value="All" Order="4"><![CDATA[Installed AND NOT PATCH AND WixUI_InstallMode = "Remove" AND (OutOfDiskSpace <> 1 OR (OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST = "D"))]]></Publish>
            <Publish Event="EndDialog" Value="Return" Order="5"><![CDATA[OutOfDiskSpace <> 1 OR (OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST = "D")]]></Publish>
            <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Order="6">OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (NOT PROMPTROLLBACKCOST OR PROMPTROLLBACKCOST = "P")</Publish>
            <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Order="7">OutOfDiskSpace = 1 AND (OutOfNoRbDiskSpace = 1 OR PROMPTROLLBACKCOST = "F")</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
            <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
    </Dialog>
</Include>
