<!--
    Datadog RUM configuration schema.
-->
<configSchema>
  <sectionSchema name="system.webServer/datadogRum">
    <attribute name="enabled" type="bool" defaultValue="true" />
    <!-- NOTE(@dmehala): arbitrarily set an upper bound because it is mandatory. -->
    <attribute name="version" type="int" defaultValue="6" validationType="integerRange" validationParameter="5,1000"/>

    <!-- Where the snippet is injected. Values mirror the InjectionStrategy enumerators. -->
    <attribute name="injectionStrategy" type="enum" defaultValue="headCloseTag">
      <enum name="headCloseTag"                    value="0" />
      <enum name="headOpenTag"                     value="1" />
      <enum name="headOpenTagWithCloseTagFallback" value="2" />
    </attribute>

    <!-- Whether the encoding declaration may be hoisted above a meta-delivered Content Security
         Policy so the snippet precedes it. Values mirror the MetaCspPlacement enumerators. -->
    <attribute name="metaCspPlacement" type="enum" defaultValue="after">
      <enum name="after"  value="0" />
      <enum name="before" value="1" />
    </attribute>

    <collection addElement="option" removeElement="remove" clearElement="clear" allowDuplicates="false">
      <attribute name="name" type="string" isUniqueKey="true" required="true" validationType="nonEmptyString" />
      <attribute name="value" type="string" required="true" validationType="nonEmptyString" />
    </collection>
  </sectionSchema>
  <sectionSchema name="system.applicationHost/datadogRumServer">
	  <attribute name="logLevel" type="enum" defaultValue="info">
      <enum name="debug" value="2" />
      <enum name="info"  value="1" />
      <enum name="error" value="0" />
    </attribute>
  </sectionSchema>
</configSchema>
