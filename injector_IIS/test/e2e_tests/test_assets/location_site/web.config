<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <datadogRum enabled="true" version="5">
      <clear />
      <option name="applicationId" value="DATADOG_APPLICATION_ID" />
      <option name="clientToken" value="DATADOG_CLIENT_TOKEN" />
      <option name="site" value="datadoghq.com" />
      <option name="service" value="location-test" />
      <option name="sessionSampleRate" value="100" />
    </datadogRum>
  </system.webServer>

  <location path="api">
    <system.webServer>
      <datadogRum enabled="false" />
    </system.webServer>
  </location>
</configuration>
