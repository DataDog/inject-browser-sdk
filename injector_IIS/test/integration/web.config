<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <datadogRum enabled="true" version="5">
      <clear />
      <option name="applicationId" value="test-app-id" />
      <option name="clientToken" value="test-client-token" />
      <option name="site" value="datadoghq.com" />
      <option name="service" value="test-service" />
      <option name="sessionSampleRate" value="100" />
    </datadogRum>
  </system.webServer>
</configuration>
